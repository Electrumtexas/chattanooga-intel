# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env / secrets — Register of Deeds credentials etc. arrive as GitHub Secrets,
# never as a committed file. See CLAUDE.md pending-work list.
.env
*.env.local

# OS cruft
.DS_Store
Thumbs.db

# Raw scrape cache — default is "don't commit," since most of these are
# daily-changing HTML/JSON blobs that would just bloat repo history.
# Per-source exceptions (a source worth caching because it's rate-limited
# enough that replaying beats re-fetching) get a `!data/raw/<source>/**`
# override here once Phase 1 reconnaissance confirms which source(s)
# actually need it — decision + rationale logged in CLAUDE.md.
data/raw/**

# data/chattanooga.db is committed (the canonical store). dashboard/*.json is
# generated by scraper/build_unified.py and published to Pages by the workflow;
# it is NOT committed (it made git history grow ~15 MB/day). To view the
# dashboard locally run build_unified.py first (it writes dashboard/*.json).
dashboard/*.json

# Skip-trace contact store: only the Fernet-encrypted data/contacts.db.enc is
# committed. The plaintext SQLite is a temp file that contacts_store.py deletes
# at the end of every run (also its journal/temp siblings) — never commit it.
data/contacts.db
data/contacts.db-*
data/contacts.db.enc.tmp
